---
import '../styles/global.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BandePhotos from '../components/BandePhotos.astro';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  titre: string;
  description?: string;
  /** Bande photos et newsletter en bas de page (comme sur le site actuel) */
  basDePage?: boolean;
}

const {
  titre,
  description = 'Cours de yoga à Tours : Hatha flow, Vinyasa et workshops avec Mathilde Bertrand.',
  basDePage = true,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Site de test : ne doit pas être indexé tant que yogside.com tourne sous WordPress -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Active les effets d'apparition uniquement si le JavaScript tourne -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <EnTete />
    <main>
      <slot />
    </main>
    {
      basDePage && (
        <div class="bas-de-page">
          <BandePhotos />
          <Newsletter />
        </div>
      )
    }
    <PiedDePage />
    <script>
      import '../scripts/effets';
    </script>
  </body>
</html>

<style>
  .bas-de-page {
    display: flex;
    flex-direction: column;
    gap: var(--espace-8);
    padding-top: var(--espace-section);
  }
</style>
