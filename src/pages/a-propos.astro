---
import Base from '../layouts/Base.astro';
import PhotoSanity from '../components/PhotoSanity.astro';
import TexteSanity from '../components/TexteSanity.astro';
import { CACHE_EDITORIAL, pageAPropos } from '../lib/sanity';

// Contenu modifiable dans Sanity (fiche « À propos »)
export const prerender = false;
Astro.response.headers.set('Cache-Control', CACHE_EDITORIAL);

const page = await pageAPropos();
const [photo1, photo2] = page.photos ?? [];
---

<Base titre="À propos — Mathilde Bertrand, Yogside" description="Mathilde Bertrand, professeure de yoga à Tours depuis 2017.">
  <section class="presentation conteneur">
    <div class="presentation__portrait" data-parallaxe="4" data-ordi-seulement>
      <PhotoSanity photo={page.portrait} largeurs={[400, 584]} ratio={1} sizes="(max-width: 64rem) 70vw, 30rem" loading="eager" />
    </div>
    <div class="presentation__texte pile">
      <h1>
        <span>{page.prenom}</span>
        <span class="presentation__nom">{page.nom}</span>
      </h1>
      <p class="texte-doux">{page.intro}</p>
    </div>
  </section>

  <section class="parcours conteneur">
    <div class="parcours__texte pile texte-doux">
      <TexteSanity blocs={page.texte1} />
      {page.citation && (
        <blockquote>
          <p><em>{page.citation}</em></p>
          {page.sourceCitation && <footer>{page.sourceCitation}</footer>}
        </blockquote>
      )}
      <TexteSanity blocs={page.texte2} />
    </div>

    <div class="parcours__photos" aria-label="Formation en Inde">
      <div class="parcours__photo parcours__photo--1" data-parallaxe="1" data-ordi-seulement>
        <PhotoSanity photo={photo1} largeurs={[400, 675]} sizes="(max-width: 64rem) 70vw, 24rem" />
      </div>
      <div class="parcours__photo parcours__photo--2" data-parallaxe="2">
        <PhotoSanity photo={photo2} largeurs={[400, 900]} sizes="(max-width: 64rem) 60vw, 18rem" />
      </div>
    </div>
  </section>

  <section class="section conteneur conclusion">
    <p data-apparition="fondu-haut">{page.conclusion}</p>
  </section>
</Base>

<style>
  /* --- Présentation --- */
  .presentation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--espace-8);
    max-width: calc(64rem + 2 * var(--marge-laterale));
    padding-block: var(--espace-8);
  }

  .presentation__portrait :global(img) {
    width: min(100%, 17rem + 10vw);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    border-radius: 50%;
  }

  .presentation__texte {
    --espace-pile: var(--espace-5);
  }

  .presentation h1 {
    display: flex;
    flex-direction: column;
    font-size: var(--texte-h1);
  }

  /* Nom décalé, comme sur le site actuel */
  .presentation__nom {
    padding-left: 1.5ch;
  }

  /* --- Parcours --- */
  .parcours {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--espace-8);
    max-width: calc(64rem + 2 * var(--marge-laterale));
  }

  .parcours__texte {
    --espace-pile: var(--espace-4);
    font-size: var(--texte-nav);
  }

  blockquote {
    margin: var(--espace-2) 0;
  }

  blockquote footer {
    margin-top: var(--espace-2);
  }

  .parcours__photos {
    position: relative;
    min-height: 32rem;
  }

  .parcours__photo :global(img) {
    width: 100%;
    height: auto;
  }

  .parcours__photo--1 {
    width: 75%;
  }

  /* Seconde photo superposée en bas à droite */
  .parcours__photo--2 {
    position: absolute;
    right: -10%;
    top: 55%;
    width: 70%;
  }

  /* --- Conclusion --- */
  .conclusion p {
    max-width: 38rem;
    margin-inline: auto;
    font-size: var(--texte-h3);
    line-height: 1.4;
    text-align: center;
    color: var(--couleur-titre);
    text-wrap: balance;
  }

  /* --- Mobile --- */
  @media (max-width: 64rem) {
    .presentation,
    .parcours {
      grid-template-columns: 1fr;
    }

    .parcours__photos {
      min-height: 0;
      padding-bottom: 40%;
    }

    .parcours__photo--2 {
      right: 0;
      top: auto;
      bottom: 0;
      width: 55%;
    }
  }
</style>
