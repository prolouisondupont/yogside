---
// Réservation d'une séance ou d'un workshop.
// GET : récapitulatif + formulaire. POST : réservation transactionnelle
// (fonction Postgres reserver), puis redirection vers la confirmation.
import Base from '../../../layouts/Base.astro';
import Bouton from '../../../components/Bouton.astro';
import Recapitulatif from '../../../components/Recapitulatif.astro';
import Jauge from '../../../components/Jauge.astro';
import { lieux, seance, workshop } from '../../../lib/donnees';
import { prix } from '../../../lib/format';
import { envoyerMailsReservation, lireFormulaire, reserver, UUID, type Formulaire } from '../../../lib/reservation';
import { textesReservation } from '../../../lib/sanity';
import { utilisateurConnecte } from '../../../lib/auth';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const textes = await textesReservation();

const { type, id } = Astro.params;
if ((type !== 'seance' && type !== 'workshop') || !id || !UUID.test(id)) {
  return new Response(null, { status: 404 });
}

let erreur = '';
let valeurs: Formulaire = { prenom: '', nom: '', email: '', telephone: '', pretTapis: false, message: '' };

// Élève connecté·e : formulaire pré-rempli et email verrouillé sur celui du compte,
// pour que la réservation apparaisse dans son espace
const { supabase, utilisateur } = await utilisateurConnecte(Astro.request, Astro.cookies);
const emailCompte = utilisateur?.email?.toLowerCase() ?? '';
let profil: { prenom: string | null; nom: string | null; telephone: string | null } | null = null;
if (utilisateur) {
  const { data } = await supabase.from('profils').select('prenom, nom, telephone').eq('id', utilisateur.id).maybeSingle();
  profil = data;
  valeurs = { ...valeurs, prenom: data?.prenom ?? '', nom: data?.nom ?? '', telephone: data?.telephone ?? '', email: emailCompte };
}

if (Astro.request.method === 'POST') {
  const donnees = await Astro.request.formData();
  // Champ piège invisible : rempli uniquement par les robots
  if (donnees.get('site_web')) return Astro.redirect('/planning', 303);

  valeurs = lireFormulaire(donnees);
  if (emailCompte) valeurs.email = emailCompte;
  const resultat = await reserver(type === 'seance' ? { seanceId: id } : { workshopId: id }, valeurs);
  if (resultat.ok) {
    // Un échec d'envoi ne doit pas faire échouer la réservation (déjà enregistrée)
    await envoyerMailsReservation(resultat.reservation_id, resultat).catch((e) => console.error('Mails de réservation', e));
    // Première réservation avec un compte : on complète le profil encore vide
    if (utilisateur && !profil?.prenom && !profil?.nom) {
      await supabase.from('profils').update({ prenom: valeurs.prenom, nom: valeurs.nom, telephone: valeurs.telephone }).eq('id', utilisateur.id);
    }
    return Astro.redirect(`/reserver/confirmation/${resultat.reservation_id}`, 303);
  }
  erreur = resultat.message;
  Astro.response.status = 422;
}

const [item, tousLesLieux] = await Promise.all([type === 'seance' ? seance(id) : workshop(id), lieux()]);
if (!item) return new Response(null, { status: 404 });

const titre = 'nom' in item ? item.nom : item.titre;
const annule = 'annulee' in item ? item.annulee : item.annule;
const tarif = 'tarif' in item ? item.tarif : null;
const lieu = tousLesLieux.get(item.lieu_id);
const complet = item.places_restantes <= 0;
---

<Base titre={`Réserver — ${titre} — Yogside`} basDePage={false}>
  <section class="conteneur reservation">
    <a href="/planning" class="retour">← Retour au planning</a>
    <h1>Réserver un cours</h1>
    <p class="texte-petit">{textes.rappel}</p>

    <div class="reservation__recap">
      <Recapitulatif titre={titre} date={item.date} heureDebut={item.heure_debut} heureFin={item.heure_fin} lieu={lieu} />
      <p class="reservation__jauge">
        <Jauge placesRestantes={item.places_restantes} annule={annule} commence={!item.reservable && !annule && !complet} />
        {tarif != null && <span class="texte-petit texte-doux"> · {prix(tarif)}, règlement sur place</span>}
      </p>
    </div>

    {
      !item.reservable && !erreur ? (
        <div class="message message--info" role="status">
          {annule ? (
            <p>Cette séance est annulée{('motif_annulation' in item && item.motif_annulation) ? ` : ${item.motif_annulation}` : '.'}</p>
          ) : complet ? (
            <p>
              Cette séance est complète. N’hésitez pas à me contacter directement :{' '}
              <a href={`mailto:${textes.email}`}>{textes.email}</a>
            </p>
          ) : (
            <p>Cette séance a déjà commencé, il n’est plus possible de réserver.</p>
          )}
          <p>
            <a href="/planning">Voir les autres séances</a>
          </p>
        </div>
      ) : (
        <form method="post" class="formulaire" novalidate={false}>
          {erreur && (
            <div class="message message--erreur" role="alert">
              <p>{erreur}</p>
            </div>
          )}

          <div class="formulaire__ligne">
            <div class="champ">
              <label for="prenom">Prénom<span aria-hidden="true">*</span></label>
              <input id="prenom" name="prenom" required autocomplete="given-name" value={valeurs.prenom} />
            </div>
            <div class="champ">
              <label for="nom">Nom<span aria-hidden="true">*</span></label>
              <input id="nom" name="nom" required autocomplete="family-name" value={valeurs.nom} />
            </div>
          </div>
          <div class="champ">
            <label for="email">Votre email<span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" value={valeurs.email} readonly={Boolean(emailCompte)} />
            {emailCompte ? (
              <span class="texte-petit texte-doux">Connecté·e avec ce compte. <a href="/mon-espace">Mon espace</a></span>
            ) : (
              <span class="texte-petit texte-doux">Déjà venu·e ? <a href={`/connexion?suivant=${Astro.url.pathname}`}>Connectez-vous</a> pour pré-remplir le formulaire.</span>
            )}
          </div>
          <div class="champ">
            <label for="telephone">Téléphone<span aria-hidden="true">*</span></label>
            <input id="telephone" name="telephone" type="tel" required autocomplete="tel" value={valeurs.telephone} />
          </div>
          <label class="case">
            <input type="checkbox" name="pret_tapis" checked={valeurs.pretTapis} />
            J’ai besoin d’un prêt de tapis
          </label>
          <div class="champ">
            <label for="message">Informations supplémentaires :</label>
            <textarea id="message" name="message" rows="3">{valeurs.message}</textarea>
          </div>

          <div class="piege" aria-hidden="true">
            <label for="site_web">Ne pas remplir</label>
            <input id="site_web" name="site_web" tabindex="-1" autocomplete="off" />
          </div>

          <p class="texte-petit texte-doux">{textes.annulation}</p>
          <p class="texte-petit texte-doux">
            Vos coordonnées servent uniquement à gérer votre réservation.
          </p>

          <div>
            <Bouton type="submit" variante="plein">Je réserve !</Bouton>
          </div>
        </form>
      )
    }
  </section>
</Base>

<style>
  .reservation {
    display: flex;
    flex-direction: column;
    gap: var(--espace-5);
    max-width: calc(36rem + 2 * var(--marge-laterale));
    padding-block: var(--espace-8) var(--espace-section);
  }

  .retour {
    font-size: var(--texte-nav);
    color: var(--couleur-texte);
    text-decoration: none;
  }

  .reservation__recap {
    display: flex;
    flex-direction: column;
    gap: var(--espace-2);
  }

  .formulaire {
    display: flex;
    flex-direction: column;
    gap: var(--espace-5);
  }

  .formulaire__ligne {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--espace-4);
  }

  .piege {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 30rem) {
    .formulaire__ligne {
      grid-template-columns: 1fr;
    }
  }
</style>
