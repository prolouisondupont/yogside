# Copier ce fichier en .env et renseigner les valeurs — .env n'est jamais commité.

# Supabase (Dashboard → Project Settings → API)
PUBLIC_SUPABASE_URL=https://vrgwjqawblmsrpxhsgex.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : uniquement côté serveur (routes Astro), jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Resend
RESEND_API_KEY=

# Brevo (newsletter) — clé côté serveur uniquement
BREVO_API_KEY=
BREVO_LISTE_ID=

# Emails (Resend) — domaine yogside.com vérifié (DKIM + SPF via CNAME chez OVH)
EMAIL_EXPEDITEUR=Yogside <reservation@yogside.com>
EMAIL_PROF=info@yogside.com
# Site de test : redirige tous les mails vers cette adresse (laisser vide en production)
EMAIL_REDIRECTION=
PUBLIC_SITE_URL=https://yogside.vercel.app

# Tâches planifiées (Vercel Cron) : chaîne aléatoire, aussi déclarée dans Vercel
CRON_SECRET=
